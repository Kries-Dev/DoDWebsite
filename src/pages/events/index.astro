---
import Base from '../../layouts/Base.astro';
import EventRow from '../../components/EventRow.astro';
import site from '../../data/site.json';
import { upcoming, past } from '../../lib/events';
---
<Base title="Events" description="Deities of Death events: the Mythic Clan League and the Monthly DoD FFA for Age of Mythology: Retold.">
  <section class="page-hero">
    <div class="wrap stack">
      <span class="eyebrow">Competitions</span>
      <h1 class="display-l">Events</h1>
      <p class="lead">Leagues, cups and community nights run by DoD. New events are announced on Discord first.</p>
    </div>
  </section>
  <section class="section">
    <div class="wrap stack" style="--gap:48px">
      <div class="stack" style="--gap:16px">
        <h2 class="h3">Upcoming</h2>
        {upcoming.length
          ? <div class="rows">{upcoming.map((e) => <EventRow event={e} />)}</div>
          : <div class="card"><p class="muted">No events scheduled right now. <a href={site.discord} rel="noopener">Join the Discord</a> to hear about the next one first.</p></div>}
      </div>
      <div class="stack" style="--gap:16px">
        <h2 class="h3">Past</h2>
        <div class="rows">{past.map((e) => <EventRow event={e} past />)}</div>
      </div>
    </div>
  </section>
</Base>
