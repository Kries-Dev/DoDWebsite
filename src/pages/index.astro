---
import Base from '../layouts/Base.astro';
import Video from '../components/Video.astro';
import site from '../data/site.json';
import coaches from '../data/coaches.json';
import projects from '../data/projects.json';
import media from '../data/media.json';
import { upcoming, past } from '../lib/events';

const next = upcoming[0];
const latest = past[0];
const feature = next ?? latest;
const shop = site.shopUrl ?? site.discord;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SportsOrganization',
  name: site.name,
  alternateName: site.short,
  url: 'https://thedodclan.com/',
  foundingDate: String(site.founded),
  sport: 'Esports',
  slogan: site.motto,
  email: site.businessEmail,
  sameAs: [site.liquipedia, ...site.socials.filter((s) => s.url).map((s) => s.url)],
};
---
<Base jsonLd={jsonLd}>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="stack">
        <span class="eyebrow">Since {site.founded}</span>
        <h1 class="display-xl">Deities of Death</h1>
        <p class="lead">Twenty years of competitive Age of Mythology and a record nine RTS-League titles. Now an RTS esports organisation — with Game of Thrones: War for Westeros as our next front.</p>
        <div class="btns" style="padding-top:8px">
          <a class="btn primary" href={site.discord} rel="noopener">Join our Discord</a>
          <a class="btn" href="/about/">Our story</a>
        </div>
      </div>

      {feature && (
        <article class="feature" aria-label={next ? 'Next event' : 'Latest event'}>
          <div class="feature-top">
            <span class="eyebrow plain" style="font-size:14px;color:var(--text)"><span class="sq" />{next ? 'NEXT EVENT' : 'LATEST EVENT'}</span>
            <span class="small muted">{feature.kind}</span>
          </div>
          <div class="feature-body stack" style="--gap:12px">
            <span class="small muted">{feature.game}</span>
            <h2 class="h3" style="font-size:36px">{feature.title}</h2>
            <p class="muted">{feature.tagline}</p>
          </div>
          <dl class="feature-facts">
            <div><dt class="tiny">When</dt><dd>{feature.when}</dd></div>
            <div><dt class="tiny">Status</dt><dd>{next ? (feature.signup ? 'Sign-ups open' : 'Upcoming') : 'Finished'}</dd></div>
          </dl>
          <a class="feature-link" href={`/events/${feature.slug}/`}>
            {next ? 'Event details' : 'See how it went'}
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 10h12M11 5l5 5-5 5" /></svg>
          </a>
          {!next && <p class="tiny" style="padding:0 24px 16px">The next event is announced on Discord first.</p>}
        </article>
      )}
    </div>
    <div class="wrap">
      <div class="stats" style="border-top:1px solid var(--line);border-bottom:0">
        <div class="stat"><div class="stat-num">20+</div><div class="stat-label">Years competing, since {site.founded}</div></div>
        <div class="stat"><div class="stat-num">9×</div><div class="stat-label">RTS-League champions</div></div>
        <div class="stat"><div class="stat-num">{site.discordMembers}</div><div class="stat-label">Discord members</div></div>
        <div class="stat"><div class="stat-num">23</div><div class="stat-label">God build-order guides</div></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap stack" style="--gap:32px">
      <div class="head-row">
        <h2 class="h2">Our games</h2>
        <a class="link-arrow" href="/games/">All games</a>
      </div>
      <div class="grid" style="--min:340px">
        <article class="card game">
          <div class="game-top"><span class="numeral" aria-hidden="true">01</span><span class="chip"><span class="dot" />Competing since {site.founded}</span></div>
          <div class="stack" style="--gap:14px">
            <h3 class="h2" style="font-size:44px">Age of Mythology: Retold</h3>
            <p class="muted">Where DoD was born. The Mythic Clan League, monthly FFAs, coaching and the community's build-order library for all 23 gods.</p>
            <div class="game-links">
              <a href="/games/aom/">Game hub</a>
              <a href="/games/aom/build-orders/">Build orders</a>
              <a href="/competitions/mcl/">MCL</a>
              <a href="/projects/">Mods</a>
            </div>
          </div>
        </article>
        <article class="card game">
          <div class="game-top"><span class="numeral" aria-hidden="true">02</span><span class="chip muted"><span class="ring" />Launching early 2027</span></div>
          <div class="stack" style="--gap:14px">
            <h3 class="h2" style="font-size:44px">Game of Thrones: War for Westeros</h3>
            <p class="muted">Our second title. We're building a roster ahead of launch — strong RTS players from any game are welcome to try out.</p>
            <div class="game-links">
              <a href="/games/war-for-westeros/">Game hub</a>
              <a href="/games/war-for-westeros/#register">Register interest</a>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap section split">
      <div class="stack">
        <span class="eyebrow">Our league</span>
        <h2 class="display-l">Mythic Clan League</h2>
        <p class="lead">A premier 3v3 clan tournament for Age of Mythology: Retold — group stage, then double-elimination playoffs. Season 1 ran from 6 April to 18 May 2026.</p>
        <div class="btns">
          <a class="btn primary" href="/competitions/mcl/">Bracket and standings</a>
          <a class="btn" href="/competitions/mcl/#podcast">MCL podcast</a>
        </div>
      </div>
      <Video id={media.podcast[0].id} title={media.podcast[0].title} />
    </div>
  </section>

  <section class="section">
    <div class="wrap stack" style="--gap:32px">
      <div class="head-row">
        <div class="stack" style="--gap:8px">
          <span class="eyebrow">Coaching</span>
          <h2 class="h2">Learn from DoD players</h2>
        </div>
        <a class="link-arrow" href="/coaching/">How booking works</a>
      </div>
      <div class="grid" style="--min:260px">
        {coaches.map((c) => (
          <article class="card coach">
            <div class="coach-top">
              <h3 class="card-title">{c.name}</h3>
              <span class="elo"><span class="tiny">ELO</span> {c.elo}</span>
            </div>
            <p class="muted">{c.speciality}</p>
            <p class="price">{c.prices.join(' · ')}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap stack" style="--gap:32px">
      <div class="head-row">
        <div class="stack" style="--gap:8px">
          <span class="eyebrow">Projects</span>
          <h2 class="h2">Built by DoD, used by the community</h2>
        </div>
        <a class="link-arrow" href="/projects/">All tools and mods</a>
      </div>
      <div class="grid" style="--min:260px">
        {projects.slice(0, 3).map((p) => (
          <a class="card" href="/projects/">
            <span class="tiny">{p.kind} · by {p.authors}</span>
            <span class="card-title">{p.name}</span>
            <span class="muted">{p.description}</span>
          </a>
        ))}
        <a class="card" href="/games/aom/build-orders/">
          <span class="tiny">Web · by [DoD]Kries</span>
          <span class="card-title">Build orders</span>
          <span class="muted">All 23 gods across 7 pantheons — eco, rush and water builds.</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap stack" style="--gap:32px">
      <h2 class="h2">Watch and listen</h2>
      <div class="grid" style="--min:280px">
        <a class="card" href={site.socials.find((s) => s.name === 'Twitch')?.url} rel="noopener">
          <span class="tiny">Twitch</span>
          <span class="card-title">Live events and matches</span>
          <span class="muted">Follow DoD streams and talk to the players live.</span>
        </a>
        <a class="card" href={site.socials.find((s) => s.name === 'YouTube')?.url} rel="noopener">
          <span class="tiny">YouTube</span>
          <span class="card-title">Build orders, reviews, cinematics</span>
          <span class="muted">Game reviews, AoM cinematography and music — beyond the game.</span>
        </a>
        <a class="card" href={site.discord} rel="noopener">
          <span class="tiny">Discord</span>
          <span class="card-title">The community hub</span>
          <span class="muted">Strategy, content and games with {site.discordMembers} members.</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap grid" style="--min:340px">
      <div class="card panel">
        <span class="eyebrow">Merch</span>
        <h2 class="h2">Suit up</h2>
        <p class="muted">Official Deities of Death gear — premium apparel for those who command the battlefield. Orders and shipping run through our partner Fourthwall.</p>
        <div class="btns"><a class="btn light" href={shop} rel="noopener">Enter the shop</a></div>
      </div>
      <div class="card panel">
        <span class="eyebrow">Donate</span>
        <h2 class="h2">Support DoD</h2>
        <p class="muted">Enjoy the league, the tools and the streams? Support DoD with a tip. Sponsors and partners: get in touch.</p>
        <div class="btns">
          <a class="btn" href={site.donate} rel="noopener">Donate</a>
          <a class="btn" href={`mailto:${site.businessEmail}`}>Business enquiries</a>
        </div>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap section cta">
      <h2 class="display-l">{site.motto}</h2>
      <p class="lead">From online battles to real-life friendships — more than a clan.</p>
      <div class="btns"><a class="btn primary" href={site.discord} rel="noopener">Join our Discord</a></div>
    </div>
  </section>
</Base>

<style>
  .hero-grid { display: grid; gap: 64px; align-items: end; padding-block: clamp(56px, 10vw, 104px) 64px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 360px), 1fr)); }
  .feature { background: var(--surface); border: 1px solid var(--line); display: flex; flex-direction: column; }
  .feature-top { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 16px 24px; border-bottom: 1px solid var(--line); }
  .sq { width: 8px; height: 8px; background: var(--red-text); }
  .feature-body { padding: 28px 24px; }
  .feature-facts { display: grid; grid-template-columns: 1fr 1fr; margin: 0; border-top: 1px solid var(--line); }
  .feature-facts div { padding: 16px 24px; }
  .feature-facts div + div { border-left: 1px solid var(--line); }
  .feature-facts dd { margin: 0; font-weight: 600; }
  .feature-link { display: flex; justify-content: space-between; align-items: center; min-height: 56px; padding: 0 24px; border-top: 1px solid var(--line); text-decoration: none; font-weight: 600; }
  .game { min-height: 380px; justify-content: space-between; gap: 32px; }
  .game-top { display: flex; justify-content: space-between; align-items: start; gap: 16px; }
  .game-links { display: flex; flex-wrap: wrap; gap: 8px 24px; border-top: 1px solid var(--line); padding-top: 16px; }
  .game-links a { font-weight: 600; text-decoration: none; min-height: 32px; display: inline-flex; align-items: center; }
  .split { display: grid; gap: 48px; align-items: center; grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr)); }
  .coach-top { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
  .elo { font-family: var(--font-display); font-weight: 700; font-size: 24px; }
  .price { font-weight: 600; border-top: 1px solid var(--line); padding-top: 12px; margin-top: auto; }
  .panel { gap: 16px; }
  .cta { display: flex; flex-direction: column; gap: 20px; align-items: flex-start; }
</style>
