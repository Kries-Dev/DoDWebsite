---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found">
  <section class="page-hero" style="border-bottom:0">
    <div class="wrap stack" style="padding-bottom:var(--section)">
      <span class="eyebrow">404</span>
      <h1 class="display-l">This page fell in battle</h1>
      <p class="lead">The page you're looking for doesn't exist or has moved.</p>
      <div class="btns"><a class="btn primary" href="/">Back to the homepage</a><a class="btn" href="/events/">Events</a></div>
    </div>
  </section>
</Base>
