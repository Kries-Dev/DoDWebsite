---
// The DoD reaper logo, transparent version (source: brand-source/reaper-transparent.png, from Logos/DeitiesofDeath2.png).
interface Props { size?: number; eager?: boolean }
const { size = 44, eager = true } = Astro.props;
const src = size <= 96 ? '/brand/dod-96.webp' : size <= 192 ? '/brand/dod-192.webp' : '/brand/dod-512.webp';
---
<img class="mark" src={src} alt="" width={size} height={size} loading={eager ? 'eager' : 'lazy'} decoding="async" />
<style>
  .mark { display: block; flex: none; }
</style>
