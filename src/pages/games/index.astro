---
import Base from '../../layouts/Base.astro';
---
<Base title="Games" description="The games Deities of Death competes in: Age of Mythology: Retold, and Game of Thrones: War for Westeros from early 2027.">
  <section class="page-hero">
    <div class="wrap stack">
      <span class="eyebrow">Games</span>
      <h1 class="display-l">Two titles, one organisation</h1>
      <p class="lead">DoD was born in Age of Mythology in 2005. Game of Thrones: War for Westeros is our second title from its launch in early 2027.</p>
    </div>
  </section>
  <section class="section">
    <div class="wrap grid" style="--min:340px">
      <a class="card" href="/games/aom/" style="min-height:320px;justify-content:space-between">
        <span class="numeral" aria-hidden="true">01</span>
        <span class="stack" style="--gap:12px">
          <span class="chip"><span class="dot" />Active</span>
          <span class="card-title" style="font-size:44px">Age of Mythology: Retold</span>
          <span class="muted">MCL, monthly FFAs, coaching, build orders and mods.</span>
        </span>
      </a>
      <a class="card" href="/games/war-for-westeros/" style="min-height:320px;justify-content:space-between">
        <span class="numeral" aria-hidden="true">02</span>
        <span class="stack" style="--gap:12px">
          <span class="chip"><span class="ring" />Early 2027</span>
          <span class="card-title" style="font-size:44px">Game of Thrones: War for Westeros</span>
          <span class="muted">Roster forming — register for tryouts.</span>
        </span>
      </a>
    </div>
  </section>
</Base>
