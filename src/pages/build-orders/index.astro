---
import Base from '../../layouts/Base.astro';
import PantheonWall from '../../components/PantheonWall.astro';
import site from '../../data/site.json';
import '@fontsource/cinzel-decorative/700.css';
import { allBuilds, gods, contributors } from '../../lib/buildOrders';
---
<Base title="Build orders" description={`Build orders from the DoD community: ${allBuilds.length} builds for all ${gods.length} gods in Age of Mythology: Retold, and Game of Thrones: War for Westeros coming soon.`}>
  <section class="bo">
    <div class="wrap bo-head">
      <span class="eyebrow">Learn the openings</span>
      <h1 class="display-l">Build orders</h1>
    </div>

    <div class="wrap" data-tabs>
      <div class="tabs bo-tabs" role="tablist" aria-label="Game">
        <button class="tab" role="tab" id="tab-aom" aria-controls="panel-aom" aria-selected="true" data-hash="aom">
          Age of Mythology: Retold <span class="tab-tag on">{allBuilds.length} builds</span>
        </button>
        <button class="tab" role="tab" id="tab-got" aria-controls="panel-got" aria-selected="false" tabindex="-1" data-hash="got">
          Game of Thrones: War for Westeros <span class="tab-tag">Coming soon</span>
        </button>
      </div>
    </div>

    <div id="panel-aom" role="tabpanel" aria-labelledby="tab-aom" tabindex="0">
      <div class="wrap bo-sub">
        <h2 class="h3">Choose your deity</h2>
        <p class="bo-stats">
          <span><b data-count={allBuilds.length}>{allBuilds.length}</b> build orders</span>
          <span><b data-count={gods.length}>{gods.length}</b> gods</span>
          <span><b data-count="7">7</b> pantheons</span>
          <span><b data-count={contributors}>{contributors}</b> contributors</span>
        </p>
      </div>
      <div class="wrap-wide">
        <PantheonWall />
      </div>
      <div class="wrap bo-foot">
        <p class="lead">A living library that feeds our community builds. Have one that works? Share it with the community.</p>
        <a class="btn primary" href={site.discord} rel="noopener">Suggest a build on Discord</a>
      </div>
    </div>

    <div id="panel-got" role="tabpanel" aria-labelledby="tab-got" tabindex="0" hidden>
      <div class="wrap">
        <div class="soon">
          <img class="soon-art" src="/games/wfw-keyart-616.webp" alt="Game of Thrones: War for Westeros" width="616" height="353" loading="lazy" />
          <div class="soon-body">
            <p class="soon-title">Coming soon...</p>
            <p class="lead">Build orders for War for Westeros arrive with the game.</p>
            <div class="btns">
              <a class="btn primary" href="/games/war-for-westeros/">War for Westeros hub</a>
              <a class="btn" href={site.discord} rel="noopener">Join our Discord</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .bo { padding-block: clamp(32px, 5vw, 56px) clamp(56px, 8vw, 96px); background: radial-gradient(80% 50% at 50% 35%, rgba(192, 57, 43, 0.08), transparent 70%); }
  .bo-head { display: flex; flex-direction: column; gap: 14px; padding-bottom: clamp(20px, 3vw, 32px); }
  .bo-tabs { margin-bottom: clamp(24px, 4vw, 40px); }
  .bo-sub { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 12px 24px; padding-bottom: 20px; }
  .bo-stats { display: flex; flex-wrap: wrap; gap: 8px 28px; color: var(--muted); font-size: 15px; }
  .bo-stats b { font-family: var(--font-display); font-size: 24px; color: var(--text); margin-right: 4px; }
  .wrap-wide { max-width: 1440px; margin: 0 auto; padding-inline: var(--gutter); }
  .bo-foot { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 20px; padding-top: 40px; }
  .soon { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); align-items: center; border: 1px solid var(--line); background: var(--surface); }
  .soon-art { display: block; width: 100%; height: 100%; object-fit: cover; aspect-ratio: 616 / 353; }
  .soon-body { display: flex; flex-direction: column; gap: 16px; padding: clamp(24px, 4vw, 48px); }
  .soon-title { font-family: 'Cinzel Decorative', 'Cinzel', Georgia, serif; font-weight: 700; font-size: clamp(34px, 4.6vw, 64px); line-height: 1; }
  @media (max-width: 860px) { .soon { grid-template-columns: 1fr; } }
</style>
