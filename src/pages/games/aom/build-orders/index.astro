---
import Base from '../../../../layouts/Base.astro';
import PantheonWall from '../../../../components/PantheonWall.astro';
import site from '../../../../data/site.json';
import { allBuilds, gods, contributors } from '../../../../lib/buildOrders';
---
<Base title="Build orders — Age of Mythology: Retold" description={`${allBuilds.length} build orders for all ${gods.length} gods in Age of Mythology: Retold, across 7 pantheons — eco, rush and water builds from the DoD community.`}>
  <section class="bo">
    <div class="wrap bo-head">
      <nav aria-label="Breadcrumb" class="crumbs"><a href="/games/aom/">Age of Mythology: Retold</a> / Build orders</nav>
      <h1 class="display-l" data-reveal>Choose your deity</h1>
      <p class="bo-stats" data-reveal="fade">
        <span><b data-count={allBuilds.length}>{allBuilds.length}</b> build orders</span>
        <span><b data-count={gods.length}>{gods.length}</b> gods</span>
        <span><b data-count="7">7</b> pantheons</span>
        <span><b data-count={contributors}>{contributors}</b> contributors</span>
      </p>
    </div>
    <div class="wrap-wide">
      <PantheonWall />
    </div>
    <div class="wrap bo-foot">
      <p class="lead">A living library that feeds our community builds. Have one that works? Share it with the community.</p>
      <a class="btn primary" href={site.discord} rel="noopener">Suggest a build on Discord</a>
    </div>
  </section>
</Base>

<style>
  .bo { padding-block: clamp(24px, 4vw, 40px) clamp(56px, 8vw, 96px); background: radial-gradient(80% 50% at 50% 35%, rgba(192, 57, 43, 0.08), transparent 70%); }
  .bo-head { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 12px; padding-bottom: clamp(20px, 3vw, 32px); }
  .bo-head .crumbs { align-self: flex-start; }
  .bo-stats { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px 28px; color: var(--muted); font-size: 15px; }
  .bo-stats b { font-family: var(--font-display); font-size: 24px; color: var(--text); margin-right: 4px; }
  .wrap-wide { max-width: 1440px; margin: 0 auto; padding-inline: var(--gutter); }
  .bo-foot { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 20px; padding-top: 40px; }
</style>
