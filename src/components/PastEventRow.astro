---
import type { PastEvent } from '../lib/events';
interface Props { event: PastEvent }
const { event: e } = Astro.props;
const Title = e.page ? 'a' : 'span';
---
<div class="pe">
  <span class="pe-date">{e.date}</span>
  <span class="pe-main">
    <Title class="pe-title" href={e.page}>{e.title}</Title>
    <span class="pe-format">{e.format}</span>
  </span>
  <span class="pe-result">
    {e.winner && <span class="pe-winner"><span class="pe-label">Winner</span> {e.winner}</span>}
    {(e.result || e.prize) && <span class="pe-score">{[e.result, e.prize].filter(Boolean).join(' · ')}</span>}
  </span>
  <span class="pe-links">
    {e.video && <a href={e.video} rel="noopener" aria-label={`Watch ${e.title}`}>
      <svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 2.5v11l9-5.5z" fill="currentColor" /></svg>Watch</a>}
    {e.bracket && <a href={e.bracket} rel="noopener">Bracket</a>}
  </span>
</div>
<style>
  .pe { display: grid; grid-template-columns: 170px minmax(0, 1fr) minmax(0, 300px) 150px; gap: 6px 24px; align-items: center; padding: 16px 24px; border-bottom: 1px solid var(--line); }
  .pe:last-child { border-bottom: 0; }
  .pe:hover { background: var(--surface); }
  .pe-date { font-weight: 600; font-size: 15px; font-variant-numeric: tabular-nums; }
  .pe-main { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .pe-title { font-family: var(--font-display); font-weight: 700; font-size: 21px; line-height: 1.15; text-decoration: none; }
  a.pe-title:hover { color: var(--red-text); }
  .pe-format { color: var(--muted); font-size: 14px; }
  .pe-result { display: flex; flex-direction: column; gap: 2px; font-size: 14px; min-width: 0; }
  .pe-label { color: var(--dim); font-size: 12px; text-transform: uppercase; letter-spacing: 0.06em; margin-right: 4px; }
  .pe-winner { font-weight: 600; }
  .pe-score { color: var(--muted); font-variant-numeric: tabular-nums; }
  .pe-links { display: flex; gap: 16px; justify-content: flex-end; font-size: 14px; font-weight: 600; }
  .pe-links a { display: inline-flex; align-items: center; gap: 6px; text-decoration: none; color: var(--muted); min-height: 32px; }
  .pe-links a:hover { color: var(--red-text); }
  .pe-links svg { color: var(--red-text); }
  @media (max-width: 900px) {
    .pe { grid-template-columns: 1fr; padding: 16px; }
    .pe-links { justify-content: flex-start; }
  }
</style>
