---
import Base from '../../../../layouts/Base.astro';
import site from '../../../../data/site.json';
import { godsByPantheon, allBuilds, gods, contributors, art } from '../../../../lib/buildOrders';
---
<Base title="Build orders — Age of Mythology: Retold" description={`${allBuilds.length} build orders for all ${gods.length} gods in Age of Mythology: Retold, across 7 pantheons — eco, rush and water builds from the DoD community.`}>
  <section class="bo-hero">
    <img class="bo-hero-bg" src="/gods/minor-bg.webp" alt="" data-parallax="0.25" fetchpriority="high" />
    <div class="bo-hero-shade" aria-hidden="true"></div>
    <div class="wrap bo-hero-inner">
      <nav aria-label="Breadcrumb" class="crumbs" data-reveal="fade"><a href="/games/aom/">Age of Mythology: Retold</a> / Build orders</nav>
      <span class="eyebrow" data-reveal>Build order library</span>
      <h1 class="display-xl" data-reveal>Choose your deity</h1>
      <p class="lead" data-reveal>A living library that feeds our community builds. Have one to share? Suggest it to the community on Discord.</p>
      <div class="bo-stats" data-stagger>
        <div data-reveal><span class="bo-num" data-count={allBuilds.length}>{allBuilds.length}</span><span class="tiny">Build orders</span></div>
        <div data-reveal><span class="bo-num" data-count={gods.length}>{gods.length}</span><span class="tiny">Gods</span></div>
        <div data-reveal><span class="bo-num" data-count="7">7</span><span class="tiny">Pantheons</span></div>
        <div data-reveal><span class="bo-num" data-count={contributors}>{contributors}</span><span class="tiny">Contributors</span></div>
      </div>
      <nav class="pan-jump" aria-label="Jump to pantheon" data-reveal="fade">
        {godsByPantheon.map((p) => <a href={`#${p.pantheon.toLowerCase()}`}>{p.pantheon}</a>)}
      </nav>
    </div>
  </section>

  {godsByPantheon.map((p) => (
    <section class="pantheon" id={p.pantheon.toLowerCase()}>
      <div class="wrap stack" style="--gap:24px">
        <div class="pan-head" data-reveal="left">
          <h2 class="h2">{p.pantheon}</h2>
          <span class="muted small">{p.gods.reduce((n, g) => n + g.builds.length, 0)} builds</span>
        </div>
        <div class="god-grid" data-stagger>
          {p.gods.map((g) => (
            <a class="god-card" href={`/games/aom/build-orders/${g.slug}/`} data-reveal>
              <span class="god-art">
                <img src={art(g.slug).card} alt="" loading="lazy" decoding="async" width="640" height="800" transition:name={`art-${g.slug}`} />
              </span>
              <span class="god-shade" aria-hidden="true"></span>
              <span class="god-meta">
                <img class="god-portrait" src={art(g.slug).portrait} alt="" loading="lazy" width="64" height="64" transition:name={`portrait-${g.slug}`} />
                <span class="god-name">{g.name}</span>
                <span class="god-count">{g.builds.length} {g.builds.length === 1 ? 'build' : 'builds'}</span>
              </span>
              <span class="god-line" aria-hidden="true"></span>
            </a>
          ))}
        </div>
      </div>
    </section>
  ))}

  <section class="band">
    <div class="wrap section stack" style="--gap:16px">
      <h2 class="h2" data-reveal>Got a build that works?</h2>
      <p class="lead" data-reveal>Post it on Discord. Community builds are reviewed, then added to the library with your name on them.</p>
      <div class="btns" data-reveal><a class="btn primary" href={site.discord} rel="noopener">Suggest a build on Discord</a></div>
    </div>
  </section>
</Base>

<style>
  .bo-hero { position: relative; overflow: hidden; border-bottom: 1px solid var(--line); isolation: isolate; }
  .bo-hero-bg { position: absolute; inset: -10% 0 auto 0; width: 100%; height: 120%; object-fit: cover; opacity: 0.45; z-index: -2; }
  .bo-hero-shade { position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, rgba(11,11,11,0.55) 0%, rgba(11,11,11,0.75) 60%, var(--bg) 100%), linear-gradient(90deg, rgba(11,11,11,0.9) 0%, rgba(11,11,11,0.2) 70%); }
  .bo-hero-inner { display: flex; flex-direction: column; gap: 20px; padding-block: clamp(56px, 9vw, 112px) 40px; }
  .bo-stats { display: flex; flex-wrap: wrap; gap: 16px 40px; padding-top: 8px; }
  .bo-stats > div { display: flex; flex-direction: column; }
  .bo-num { font-family: var(--font-display); font-weight: 700; font-size: 48px; line-height: 1; }
  .pan-jump { display: flex; flex-wrap: wrap; gap: 8px; padding-top: 16px; }
  .pan-jump a { min-height: 40px; display: inline-flex; align-items: center; padding: 0 16px; border: 1px solid var(--line-strong); background: rgba(11,11,11,0.6); text-decoration: none; font-weight: 600; font-size: 15px; transition: border-color 0.2s, background 0.2s; }
  .pan-jump a:hover { border-color: var(--red); background: rgba(192,57,43,0.12); color: var(--text); }

  .pantheon { padding-top: clamp(56px, 7vw, 88px); scroll-margin-top: 96px; }
  .pantheon:last-of-type { padding-bottom: clamp(56px, 7vw, 88px); }
  .pan-head { display: flex; align-items: baseline; gap: 16px; border-bottom: 1px solid var(--line); padding-bottom: 16px; }

  .god-grid { display: grid; gap: 16px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 230px), 1fr)); }
  .god-card { position: relative; display: block; aspect-ratio: 4 / 5; overflow: hidden; background: var(--surface); border: 1px solid var(--line); text-decoration: none; isolation: isolate; }
  .god-art { position: absolute; inset: 0; z-index: -2; overflow: hidden; }
  .god-art img { width: 100%; height: 100%; object-fit: cover; transform: scale(1.02); transition: transform 0.9s var(--ease-out), filter 0.6s; filter: saturate(0.85) brightness(0.85); }
  .god-shade { position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, rgba(11,11,11,0) 35%, rgba(11,11,11,0.75) 70%, rgba(11,11,11,0.96) 100%); }
  .god-meta { position: absolute; left: 0; right: 0; bottom: 0; padding: 20px; display: grid; grid-template-columns: auto 1fr; grid-template-rows: auto auto; column-gap: 14px; align-items: center; }
  .god-portrait { grid-row: 1 / 3; width: 56px; height: 56px; border-radius: 50%; border: 1.5px solid rgba(245,245,245,0.7); box-shadow: 0 0 0 4px rgba(11,11,11,0.6); transition: border-color 0.3s, transform 0.5s var(--ease-out); }
  .god-name { font-family: var(--font-display); font-weight: 700; font-size: 30px; line-height: 1; }
  .god-count { font-size: 14px; color: var(--muted); }
  .god-line { position: absolute; left: 0; bottom: 0; height: 3px; width: 100%; background: var(--red); transform: scaleX(0); transform-origin: left; transition: transform 0.5s var(--ease-out); }
  .god-card:hover .god-art img, .god-card:focus-visible .god-art img { transform: scale(1.09); filter: saturate(1.05) brightness(1); }
  .god-card:hover .god-line, .god-card:focus-visible .god-line { transform: scaleX(1); }
  .god-card:hover .god-portrait { border-color: var(--red-text); transform: translateY(-3px); }
  .god-card:hover { color: var(--text); }
</style>
