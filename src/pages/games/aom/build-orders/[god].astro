---
import Base from '../../../../layouts/Base.astro';
import BuildTypeBadge from '../../../../components/BuildTypeBadge.astro';
import site from '../../../../data/site.json';
import SceneFx from '../../../../components/SceneFx.astro';
import { gods, art, scene, type God } from '../../../../lib/buildOrders';

export function getStaticPaths() {
  return gods.map((g) => ({ params: { god: g.slug }, props: { god: g } }));
}
interface Props { god: God }
const { god } = Astro.props;
const a = art(god.slug);
const sc = scene(god.slug)!;
const siblings = gods.filter((g) => g.pantheon === god.pantheon && g.slug !== god.slug);
const counts = { eco: 0, rush: 0, water: 0 } as Record<string, number>;
god.builds.forEach((b) => (counts[b.type] = (counts[b.type] ?? 0) + 1));
const filters = [
  { id: 'all', label: 'All', n: god.builds.length },
  { id: 'eco', label: 'Eco', n: counts.eco },
  { id: 'rush', label: 'Rush', n: counts.rush },
  { id: 'water', label: 'Water', n: counts.water },
].filter((f) => f.id === 'all' || f.n > 0);
const crops = ['50% 20%', '50% 45%', '50% 70%', '30% 35%', '70% 35%'];
---
<Base title={`${god.name} build orders`} description={`${god.builds.length} ${god.name} build orders for Age of Mythology: Retold (${god.pantheon}) — eco, rush and water builds from the DoD community.`}>
  <section class="gh" data-scene={sc.id}>
    <div class="gh-scene" aria-hidden="true" data-parallax="0.18">
      <img src={sc.sky} alt="" width="1920" height="490" fetchpriority="high" />
    </div>
    <SceneFx kinds={sc.fx} seed={god.slug.length * 7 + 3} scale={1.5} />
    <div class="gh-shade" aria-hidden="true"></div>
    <div class="wrap gh-inner">
      <nav aria-label="Breadcrumb" class="crumbs"><a href="/games/aom/build-orders/">Build orders</a> / {god.pantheon} / {god.name}</nav>
      <div class="gh-title">
        <span class="gh-medal">
          <img src={sc.medal} alt="" width="180" height="180" style={`view-transition-name: god-${god.slug}`} />
        </span>
        <div class="stack" style="--gap:8px">
          <span class="eyebrow" data-reveal="fade">{god.pantheon} · Age of Mythology: Retold</span>
          <h1 class="display-xl gh-name" data-reveal>{god.name}</h1>
        </div>
      </div>
      <p class="lead gh-lead" data-reveal>{god.builds.length} community {god.builds.length === 1 ? 'build' : 'builds'} — {Object.entries(counts).filter(([, n]) => n).map(([t, n]) => `${n} ${t}`).join(', ')}.</p>
    </div>
  </section>

  <section class="wrap bo-tools" aria-label="Filter builds">
    <div class="pills" role="group" aria-label="Build type">
      {filters.map((f, i) => (
        <button type="button" class="pill" data-filter={f.id} aria-pressed={i === 0 ? 'true' : 'false'}>
          {f.label}<span class="pill-n">{f.n}</span>
        </button>
      ))}
    </div>
    <label class="search">
      <span class="sr">Search builds</span>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
      <input type="search" placeholder="Search builds or authors" data-search autocomplete="off" />
    </label>
  </section>

  <section class="wrap bo-list">
    <div class="bo-grid" data-stagger>
      {god.builds.map((b, i) => (
        <a class="bo-card" href={b.url} data-reveal data-type={b.type} data-text={`${b.name} ${b.authors}`.toLowerCase()}>
          <span class="bo-art">
            <img src={a.card} alt="" loading="lazy" decoding="async" style={`object-position:${crops[i % crops.length]}`} />
            <span class="bo-badge"><BuildTypeBadge type={b.type} /></span>
          </span>
          <span class="bo-body">
            <span class="bo-name">{b.name}</span>
            <span class="bo-by">by {b.authors}</span>
          </span>
          <span class="bo-foot">
            <span class="bo-ages">
              {b.classical && <span><span class="tiny">Classical</span> {b.classical}</span>}
              {b.advance && <span><span class="tiny">Advance</span> {b.advance}</span>}
              {b.heroic && <span><span class="tiny">Heroic</span> {b.heroic}</span>}
              {b.mythic && <span><span class="tiny">Mythic</span> {b.mythic}</span>}
            </span>
            <span class="bo-open">Open build
              <svg width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 10h12M11 5l5 5-5 5" /></svg>
            </span>
          </span>
        </a>
      ))}
    </div>
    <p class="bo-empty muted" hidden data-empty>No builds match. Try another filter or search.</p>
  </section>

  {siblings.length > 0 && (
    <section class="wrap sib">
      <h2 class="h3">More {god.pantheon} gods</h2>
      <div class="sib-row" data-stagger>
        {siblings.map((g) => (
          <a class="sib-card" href={`/games/aom/build-orders/${g.slug}/`} data-reveal>
            <img src={scene(g.slug)!.medal} alt="" width="56" height="56" loading="lazy" />
            <span><span class="sib-name">{g.name}</span><span class="tiny">{g.builds.length} builds</span></span>
          </a>
        ))}
        <a class="sib-card all" href="/games/aom/build-orders/">All gods →</a>
      </div>
    </section>
  )}

  <section class="band">
    <div class="wrap section-sm head-row">
      <p class="lead" style="color:var(--text)">Have a {god.name} build that works? Share it with the community.</p>
      <a class="btn primary" href={site.discord} rel="noopener">Suggest a build on Discord</a>
    </div>
  </section>
</Base>

<script>
  document.addEventListener('astro:page-load', () => {
    const pills = Array.from(document.querySelectorAll<HTMLButtonElement>('.pill[data-filter]'));
    const search = document.querySelector<HTMLInputElement>('[data-search]');
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.bo-card'));
    const empty = document.querySelector<HTMLElement>('[data-empty]');
    if (!pills.length || !search) return;
    let type = 'all';
    const apply = () => {
      const q = search.value.trim().toLowerCase();
      let shown = 0;
      cards.forEach((c) => {
        const ok = (type === 'all' || c.dataset.type === type) && (!q || (c.dataset.text ?? '').includes(q));
        c.hidden = !ok;
        if (ok) {
          shown++;
          c.classList.remove('pop');
          void c.offsetWidth; // restart the entrance animation
          c.classList.add('pop');
        }
      });
      if (empty) empty.hidden = shown > 0;
    };
    pills.forEach((p) => p.addEventListener('click', () => {
      type = p.dataset.filter ?? 'all';
      pills.forEach((x) => x.setAttribute('aria-pressed', String(x === p)));
      apply();
    }));
    search.addEventListener('input', apply);
  });
</script>

<style>
  .gh { position: relative; overflow: hidden; isolation: isolate; border-bottom: 1px solid var(--line); min-height: clamp(460px, 44vw, 640px); display: flex; align-items: flex-end; }
  .gh-scene { position: absolute; inset: -6% 0 0; z-index: -2; }
  .gh-scene img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 40%; }
  @media (prefers-reduced-motion: no-preference) {
    .gh-scene img { animation: gh-drift 28s ease-in-out infinite alternate; }
    .gh-medal { animation: gh-float 6s ease-in-out infinite; }
    .gh-medal img { animation: gh-glow 3.2s ease-in-out infinite; }
  }
  @keyframes gh-drift { from { transform: scale(1.02); } to { transform: scale(1.09) translate(-1.5%, -1%); } }
  @keyframes gh-float { 50% { transform: translateY(-6px); } }
  @keyframes gh-glow {
    0%, 100% { box-shadow: 0 0 0 1px rgba(224,173,74,0.6), 0 0 22px 4px rgba(224,173,74,0.35), 0 16px 40px rgba(0,0,0,0.8); }
    50% { box-shadow: 0 0 0 1px rgba(224,173,74,0.9), 0 0 34px 10px rgba(224,173,74,0.55), 0 16px 40px rgba(0,0,0,0.8), 0 0 70px 14px rgba(192,57,43,0.35); }
  }
  .gh-shade { position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background: linear-gradient(180deg, rgba(11,11,11,0.15) 0%, rgba(11,11,11,0.1) 35%, rgba(11,11,11,0.78) 78%, var(--bg) 100%),
                linear-gradient(90deg, rgba(11,11,11,0.7) 0%, rgba(11,11,11,0.25) 50%, rgba(11,11,11,0) 80%); }
  .gh-inner { width: 100%; display: flex; flex-direction: column; gap: 18px; padding-block: 96px 40px; position: relative; z-index: 3; }
  .gh-title { display: flex; align-items: center; gap: 28px; flex-wrap: wrap; }
  .gh-medal { display: block; flex: none; width: clamp(110px, 12vw, 168px); aspect-ratio: 1; }
  .gh-medal img { width: 100%; height: 100%; border-radius: 50%; }
  .gh-name { text-shadow: 0 4px 32px rgba(0,0,0,0.75); }
  .gh-lead { color: #e2ddd4; text-shadow: 0 2px 12px rgba(0,0,0,0.8); }
  .gh .crumbs, .gh .crumbs a { color: #d8d2c6; text-shadow: 0 1px 8px rgba(0,0,0,0.8); }
  @media (max-width: 720px) {
    .gh-title { gap: 16px; }
    .gh-inner { padding-top: 140px; }
  }

  .bo-tools { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 16px; padding-block: 32px 24px; position: sticky; top: 76px; z-index: 3; background: linear-gradient(180deg, var(--bg) 80%, rgba(11,11,11,0)); }
  .pills { display: flex; flex-wrap: wrap; gap: 8px; }
  .pill { min-height: 44px; padding: 0 16px; display: inline-flex; align-items: center; gap: 10px; background: transparent; color: var(--muted); border: 1px solid var(--line-strong); font: 600 15px var(--font-body); cursor: pointer; transition: color 0.2s, border-color 0.2s, background 0.2s; }
  .pill:hover { color: var(--text); border-color: var(--muted); }
  .pill[aria-pressed='true'] { color: var(--text); border-color: var(--red); background: rgba(192,57,43,0.14); }
  .pill-n { font-size: 13px; color: var(--dim); }
  .search { display: flex; align-items: center; gap: 10px; min-height: 44px; padding: 0 14px; border: 1px solid var(--line-strong); background: var(--surface); color: var(--dim); flex: 0 1 340px; }
  .search:focus-within { border-color: var(--muted); }
  .search input { all: unset; flex: 1; color: var(--text); font: 400 16px var(--font-body); min-width: 0; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }

  .bo-list { padding-bottom: 72px; }
  .bo-grid { display: grid; gap: 16px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 290px), 1fr)); }
  .bo-card { display: flex; flex-direction: column; background: var(--surface); border: 1px solid var(--line); text-decoration: none; overflow: hidden; transition: border-color 0.3s, transform 0.5s var(--ease-out); }
  .bo-card[hidden] { display: none; }
  .bo-art { position: relative; aspect-ratio: 16 / 7; overflow: hidden; background: var(--surface-2); }
  .bo-art img { width: 100%; height: 100%; object-fit: cover; filter: saturate(0.8) brightness(0.7); transform: scale(1.04); transition: transform 0.8s var(--ease-out), filter 0.5s; }
  .bo-art::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(20,20,20,0) 30%, var(--surface) 100%); }
  .bo-badge { position: absolute; left: 16px; top: 14px; z-index: 1; }
  .bo-body { display: flex; flex-direction: column; gap: 4px; padding: 4px 20px 16px; }
  .bo-name { font-family: var(--font-display); font-weight: 700; font-size: 26px; line-height: 1.05; }
  .bo-by { font-size: 14px; color: var(--muted); }
  .bo-foot { margin-top: auto; display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; padding: 12px 20px; border-top: 1px solid var(--line); font-weight: 600; font-size: 15px; }
  .bo-ages { display: flex; gap: 14px; flex-wrap: wrap; }
  .bo-open { display: inline-flex; align-items: center; gap: 6px; color: var(--muted); transition: color 0.2s, gap 0.3s var(--ease-out); }
  .bo-card:hover { border-color: var(--line-strong); transform: translateY(-4px); color: var(--text); }
  .bo-card:hover .bo-art img { transform: scale(1.12); filter: saturate(1) brightness(0.85); }
  .bo-card:hover .bo-open { color: var(--red-text); gap: 10px; }
  .bo-card.pop { animation: pop 0.5s var(--ease-out); }
  @keyframes pop { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }

  .sib { padding-bottom: 72px; display: flex; flex-direction: column; gap: 16px; }
  .sib-row { display: flex; flex-wrap: wrap; gap: 12px; }
  .sib-card { display: flex; align-items: center; gap: 12px; padding: 10px 18px 10px 10px; min-height: 64px; background: var(--surface); border: 1px solid var(--line); text-decoration: none; transition: border-color 0.2s; }
  .sib-card img { width: 48px; height: 48px; border-radius: 50%; }
  .sib-card > span { display: flex; flex-direction: column; line-height: 1.2; }
  .sib-name { font-family: var(--font-display); font-weight: 700; font-size: 20px; }
  .sib-card:hover { border-color: var(--red); color: var(--text); }
  .sib-card.all { padding: 0 20px; font-weight: 600; }
  .section-sm { padding-block: 40px; }
</style>
