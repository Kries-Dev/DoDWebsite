---
import Base from '../../layouts/Base.astro';
import GameCard from '../../components/GameCard.astro';
---
<Base title="Games" description="The games Deities of Death competes in: Age of Mythology: Retold, and Game of Thrones: War for Westeros from early 2027.">
  <section class="page-hero">
    <div class="wrap stack">
      <span class="eyebrow">Games</span>
      <h1 class="display-l">Two titles, one organisation</h1>
      <p class="lead">DoD was born in Age of Mythology in 2005. Game of Thrones: War for Westeros is our second title from its launch in early 2027.</p>
    </div>
  </section>
  <section class="section">
    <div class="wrap games-row">
      <GameCard game="aom" active status="Active" title="Age of Mythology: Retold" href="/games/aom/"
        text="MCL, monthly FFAs, coaching, build orders and mods." />
      <GameCard game="wfw" status="2027" title="Game of Thrones: War for Westeros" href="/games/war-for-westeros/"
        text="Roster forming — register for tryouts." />
    </div>
  </section>
</Base>

<style>
  .games-row { display: grid; gap: 24px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr)); align-items: stretch; }
</style>
