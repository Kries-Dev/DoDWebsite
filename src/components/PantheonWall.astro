---
// Kries's "Choose your deity" graphic, brought to life.
// Scenes are his original panels; every medallion is cut from the same art (scripts/make-pantheon-wall.mjs)
// and laid exactly over its painted spot, so it can lift out, glow, show a label and fly into the god page.
import wall from '../data/pantheon-wall.json';
import site from '../data/site.json';
import { gods } from '../lib/buildOrders';
import SceneFx from './SceneFx.astro';

type Slot = { slot: string; medal: string; x: number; y: number; d: number };
type Panel = { id: string; pantheon?: string; image: string; imageSmall?: string; filler?: boolean; fx?: string[]; slots: Slot[] };
const panels = (wall.rows as Panel[][]).flat();
const godBySlug = new Map(gods.map((g) => [g.slug, g]));
const pantheonBuilds = (slots: Slot[]) => slots.reduce((n, s) => n + (godBySlug.get(s.slot)?.builds.length ?? 0), 0);

---
<div class="wall" data-wall>
  {panels.map((p, i) => (
    <div class:list={['pan', { filler: p.filler }]} style={`--i:${i}`} data-pan={p.id}>
      <div class="pan-world">
      <div class="pan-scene" aria-hidden="true">
        {p.imageSmall
          ? <img src={p.image} srcset={`${p.imageSmall} 960w, ${p.image} 1600w`} sizes="(max-width: 760px) 100vw, 33vw" alt="" decoding="async" width="1600" height="900" loading={i < 6 ? 'eager' : 'lazy'} />
          : <img src={p.image} alt="" decoding="async" width="1600" height="900" loading="lazy" />}
      </div>
      {p.slots.map((s, k) => {
        const style = `--x:${s.x}%;--y:${s.y}%;--d:${s.d}%;--k:${k}`;
        const edge = { 'tag-r': k === 3, 'tag-l': k === 0 };
        if (s.slot === 'discord') {
          return (
            <a class:list={['medal', 'medal-dod', edge]} href={site.discord} rel="noopener" style={style} aria-label="Suggest a build on Discord">
              <span class="medal-socket" aria-hidden="true"></span>
              <img class="medal-img" src={s.medal} alt="" width="180" height="180" decoding="async" />
              <span class="medal-tag"><strong>Your build here?</strong><span>Suggest it on Discord</span></span>
            </a>
          );
        }
        const g = godBySlug.get(s.slot)!;
        return (
          <a class:list={['medal', edge]} href={`/games/aom/build-orders/${g.slug}/`} style={style} aria-label={`${g.name}, ${g.builds.length} build orders`}>
            <span class="medal-socket" aria-hidden="true"></span>
            <img class="medal-img" src={s.medal} alt="" width="180" height="180" decoding="async" />
            <span class="medal-tag"><strong>{g.name}</strong><span>{g.builds.length} {g.builds.length === 1 ? 'build' : 'builds'}</span></span>
          </a>
        );
      })}
      </div>
      <SceneFx kinds={p.fx} seed={11 + i} />
      {p.pantheon && (
        <span class="pan-label">
          <span class="pan-name">{p.pantheon}</span>
          <span class="pan-count">{pantheonBuilds(p.slots)} builds</span>
        </span>
      )}
    </div>
  ))}
</div>

<style>
  .wall {
    display: grid; grid-template-columns: repeat(3, minmax(0, 1fr));
    border: 1px solid #5a1a14; background: #050505;
    box-shadow: 0 0 0 1px #0b0b0b, 0 40px 120px -30px rgba(192, 57, 43, 0.35);
  }
  .pan { position: relative; aspect-ratio: 16 / 9; overflow: hidden; isolation: isolate; transition: filter 0.5s ease; }
  .pan-world { position: absolute; inset: 0; z-index: 0; transform-origin: 50% 40%; }
  .pan-scene { position: absolute; inset: 0; }
  .pan-scene img { width: 100%; height: 100%; object-fit: cover; }
  .pan::after { content: ''; position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background: radial-gradient(130% 100% at 50% 40%, transparent 60%, rgba(0,0,0,0.5) 100%); }

  /* Pantheon label — slides in on hover/focus */
  .pan-label { position: absolute; left: 3.5%; top: 6%; display: flex; flex-direction: column; line-height: 1; pointer-events: none; z-index: 3;
    opacity: 0; transform: translateY(-8px); transition: opacity 0.35s, transform 0.45s var(--ease-out); text-shadow: 0 2px 14px rgba(0,0,0,0.95); }
  .pan-name { font-family: var(--font-display); font-weight: 700; font-size: clamp(18px, 2vw, 30px); }
  .pan-count { font-size: 13px; color: #ece6da; }
  .pan:hover .pan-label, .pan:focus-within .pan-label { opacity: 1; transform: none; }
  .pan:has(.medal:hover, .medal:focus-visible) .pan-label { opacity: 0; }

  /* Medallions: the cut-out sits exactly over its painted twin */
  .medal { position: absolute; left: var(--x); top: var(--y); width: var(--d); aspect-ratio: 1; transform: translate(-50%, -50%); border-radius: 50%; z-index: 2; text-decoration: none; }
  .medal-img { position: absolute; inset: 0; width: 100%; height: 100%; border-radius: 50%; transition: transform 0.5s var(--ease-out), filter 0.4s, box-shadow 0.4s; }
  .medal-socket { position: absolute; inset: 4%; border-radius: 50%; background: radial-gradient(circle, rgba(0,0,0,0.85) 55%, rgba(0,0,0,0) 72%); opacity: 0; transition: opacity 0.4s; }
  .medal:hover, .medal:focus-visible { z-index: 4; outline: none; }
  .pan:has(.medal:hover, .medal:focus-visible) .pan-world { z-index: 3; }
  .medal:hover .medal-socket, .medal:focus-visible .medal-socket { opacity: 1; }
  .medal:hover .medal-img, .medal:focus-visible .medal-img {
    transform: translateY(-9%) scale(1.13);
    filter: brightness(1.12) saturate(1.1);
    box-shadow: 0 0 0 2px rgba(224, 173, 74, 0.9), 0 0 26px 8px rgba(224, 173, 74, 0.5), 0 18px 40px rgba(0,0,0,0.75), 0 0 70px 16px rgba(192, 57, 43, 0.45);
    animation: ring-pulse 1.8s ease-in-out 0.5s infinite;
  }
  .medal-dod:hover .medal-img, .medal-dod:focus-visible .medal-img {
    box-shadow: 0 0 0 2px var(--red), 0 0 30px 10px rgba(192, 57, 43, 0.65), 0 18px 40px rgba(0,0,0,0.75);
    animation: none;
  }
  @keyframes ring-pulse {
    50% { box-shadow: 0 0 0 2px rgba(224, 173, 74, 1), 0 0 36px 12px rgba(224, 173, 74, 0.65), 0 18px 40px rgba(0,0,0,0.75), 0 0 90px 22px rgba(192, 57, 43, 0.55); }
  }

  /* Label above the medallion */
  .medal-tag { position: absolute; left: 50%; bottom: 112%; transform: translate(-50%, 6px); display: flex; flex-direction: column; align-items: center; white-space: nowrap;
    padding: 6px 12px; background: rgba(8, 8, 8, 0.92); border: 1px solid #3a2a12; border-bottom: 2px solid var(--red);
    font-size: 12px; color: var(--muted); line-height: 1.2; opacity: 0; pointer-events: none; transition: opacity 0.25s, transform 0.4s var(--ease-out); }
  .medal-tag strong { font-family: var(--font-display); font-size: 18px; color: var(--text); }
  .medal:hover .medal-tag, .medal:focus-visible .medal-tag { opacity: 1; transform: translate(-50%, 0); }
  .tag-r .medal-tag { left: auto; right: -4%; transform: translate(0, 6px); align-items: flex-end; }
  .tag-l .medal-tag { left: -4%; transform: translate(0, 6px); align-items: flex-start; }
  .tag-r:hover .medal-tag, .tag-r:focus-visible .medal-tag, .tag-l:hover .medal-tag, .tag-l:focus-visible .medal-tag { transform: none; }

  /* Hovering a pantheon spotlights it */
  @media (hover: hover) {
    .wall:has(.pan:not(.filler):hover) .pan:not(:hover) { filter: brightness(0.4) saturate(0.55); }
    .pan:not(.filler):hover { filter: brightness(1.06) saturate(1.06); }
  }

  @media (prefers-reduced-motion: no-preference) {
    .pan-world { animation: drift 26s ease-in-out infinite alternate; animation-delay: calc(var(--i) * -3.5s); }
  }
  @keyframes drift { from { transform: scale(1.01); } to { transform: scale(1.07) translate(-1.2%, -0.8%); } }

  /* Phones: scenes stack, the side panels drop out, labels always visible */
  @media (max-width: 760px) {
    .wall { grid-template-columns: 1fr; }
    .pan.filler { display: none; }
    .pan-label { opacity: 1; transform: none; }
    .medal-tag { display: none; }
  }
</style>
