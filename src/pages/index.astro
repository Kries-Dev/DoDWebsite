---
import Base from '../layouts/Base.astro';
import Video from '../components/Video.astro';
import Intro from '../components/Intro.astro';
import '@fontsource/cinzel-decorative/700.css';
import site from '../data/site.json';
import coaches from '../data/coaches.json';
import projects from '../data/projects.json';
import media from '../data/media.json';
import { upcoming, past } from '../lib/events';

const next = upcoming[0];
const latest = past[0];
const feature = next ?? latest;
const shop = site.shopUrl ?? site.discord;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SportsOrganization',
  name: site.name,
  alternateName: site.short,
  url: 'https://thedodclan.com/',
  foundingDate: String(site.founded),
  sport: 'Esports',
  slogan: site.motto,
  email: site.businessEmail,
  sameAs: [site.liquipedia, ...site.socials.filter((s) => s.url).map((s) => s.url)],
};
---
<Base jsonLd={jsonLd}>
  <script is:inline slot="head">
    // Decide before first paint whether the intro plays, so the hero never flashes up first.
    (function () {
      try {
        var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
        var seen = false;
        try { seen = sessionStorage.getItem('dodIntroSeen') === '1'; } catch (e) {}
        if (!reduce && (location.hash === '#intro' || !seen)) {
          var r = document.documentElement;
          r.classList.add('intro-on');
          // Safety net: if the intro script never starts, show the site anyway.
          setTimeout(function () { if (!r.dataset.introStarted) r.classList.remove('intro-on'); }, 4000);
        }
      } catch (e) {}
    })();
  </script>
  <link rel="preload" as="image" href="/intro/dod-emblem.webp" slot="head" />

  <Intro />

  <section class="hero home-hero">
    <canvas class="embers" id="heroEmbers" aria-hidden="true"></canvas>
    <div class="wrap hero-grid">
      <div class="stack hero-copy">
        <span class="eyebrow" data-intro-reveal style="--d:2">Since {site.founded}</span>
        <h1 class="hero-title" data-intro-reveal style="--d:3">Deities of Death<span class="hero-sub">E-Sports</span></h1>
        <p class="lead" data-intro-reveal style="--d:4">Twenty years of competitive Age of Mythology and a record nine RTS-League titles. Now an RTS esports organisation — with Game of Thrones: War for Westeros as our next front.</p>
        <div class="btns" data-intro-reveal style="--d:5;padding-top:8px">
          <a class="btn primary" href={site.discord} rel="noopener">Join our Discord</a>
          <a class="btn" href="/about/">Our story</a>
        </div>
      </div>
      <div class="hero-art">
        <img id="heroEmblem" src="/intro/dod-emblem.webp" alt="Deities of Death reaper emblem" width="1012" height="1017" fetchpriority="high" />
      </div>
    </div>
    <div class="wrap" data-intro-reveal style="--d:6">
      <div class="stats" style="border-top:1px solid var(--line);border-bottom:0">
        <div class="stat"><div class="stat-num">20+</div><div class="stat-label">Years competing, since {site.founded}</div></div>
        <div class="stat"><div class="stat-num">9×</div><div class="stat-label">RTS-League champions</div></div>
        <div class="stat"><div class="stat-num">{site.discordMembers}</div><div class="stat-label">Discord members</div></div>
        <div class="stat"><div class="stat-num">23</div><div class="stat-label">God build-order guides</div></div>
      </div>
    </div>
  </section>

  {feature && (
    <a class="event-strip" href={`/events/${feature.slug}/`} aria-label={`${next ? 'Next event' : 'Latest event'}: ${feature.title}`} data-intro-reveal style="--d:7">
      <div class="wrap event-strip-inner">
        <span class="es-label"><span class="es-dot" />{next ? 'Next event' : 'Latest event'}</span>
        <span class="es-title">{feature.title}</span>
        <span class="es-meta">{feature.game}</span>
        <span class="es-meta">{feature.when}</span>
        <span class="es-meta">{next ? (feature.signup ? 'Sign-ups open' : 'Upcoming') : 'Finished'}</span>
        <span class="es-go">{next ? 'Event details' : 'See how it went'}
          <svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 10h12M11 5l5 5-5 5" /></svg>
        </span>
      </div>
    </a>
  )}

  <section class="section">
    <div class="wrap stack" style="--gap:32px">
      <div class="head-row">
        <h2 class="h2">Our games</h2>
        <a class="link-arrow" href="/games/">All games</a>
      </div>
      <div class="grid" style="--min:340px">
        <article class="card game">
          <div class="game-top"><span class="numeral" aria-hidden="true">01</span><span class="chip"><span class="dot" />Competing since {site.founded}</span></div>
          <div class="stack" style="--gap:14px">
            <h3 class="h2" style="font-size:44px">Age of Mythology: Retold</h3>
            <p class="muted">Where DoD was born. The Mythic Clan League, monthly FFAs, coaching and the community's build-order library for all 23 gods.</p>
            <div class="game-links">
              <a href="/games/aom/">Game hub</a>
              <a href="/games/aom/build-orders/">Build orders</a>
              <a href="/competitions/mcl/">MCL</a>
              <a href="/projects/">Mods</a>
            </div>
          </div>
        </article>
        <article class="card game">
          <div class="game-top"><span class="numeral" aria-hidden="true">02</span><span class="chip muted"><span class="ring" />Launching early 2027</span></div>
          <div class="stack" style="--gap:14px">
            <h3 class="h2" style="font-size:44px">Game of Thrones: War for Westeros</h3>
            <p class="muted">Our second title. We're building a roster ahead of launch — strong RTS players from any game are welcome to try out.</p>
            <div class="game-links">
              <a href="/games/war-for-westeros/">Game hub</a>
              <a href="/games/war-for-westeros/#register">Register interest</a>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap section split">
      <div class="stack">
        <span class="eyebrow">Our league</span>
        <h2 class="display-l">Mythic Clan League</h2>
        <p class="lead">A premier 3v3 clan tournament for Age of Mythology: Retold — group stage, then double-elimination playoffs. Season 1 ran from 6 April to 18 May 2026.</p>
        <div class="btns">
          <a class="btn primary" href="/competitions/mcl/">Bracket and standings</a>
          <a class="btn" href="/competitions/mcl/#podcast">MCL podcast</a>
        </div>
      </div>
      <Video id={media.podcast[0].id} title={media.podcast[0].title} />
    </div>
  </section>

  <section class="section">
    <div class="wrap stack" style="--gap:32px">
      <div class="head-row">
        <div class="stack" style="--gap:8px">
          <span class="eyebrow">Coaching</span>
          <h2 class="h2">Learn from DoD players</h2>
        </div>
        <a class="link-arrow" href="/coaching/">How booking works</a>
      </div>
      <div class="grid" style="--min:260px">
        {coaches.map((c) => (
          <article class="card coach">
            <div class="coach-top">
              <h3 class="card-title">{c.name}</h3>
              <span class="elo"><span class="tiny">ELO</span> {c.elo}</span>
            </div>
            <p class="muted">{c.speciality}</p>
            <p class="price">{c.prices.join(' · ')}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap stack" style="--gap:32px">
      <div class="head-row">
        <div class="stack" style="--gap:8px">
          <span class="eyebrow">Projects</span>
          <h2 class="h2">Built by DoD, used by the community</h2>
        </div>
        <a class="link-arrow" href="/projects/">All tools and mods</a>
      </div>
      <div class="grid" style="--min:260px">
        {projects.slice(0, 3).map((p) => (
          <a class="card" href="/projects/">
            <span class="tiny">{p.kind} · by {p.authors}</span>
            <span class="card-title">{p.name}</span>
            <span class="muted">{p.description}</span>
          </a>
        ))}
        <a class="card" href="/games/aom/build-orders/">
          <span class="tiny">Web · by [DoD]Kries</span>
          <span class="card-title">Build orders</span>
          <span class="muted">All 23 gods across 7 pantheons — eco, rush and water builds.</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap stack" style="--gap:32px">
      <h2 class="h2">Watch and listen</h2>
      <div class="grid" style="--min:280px">
        <a class="card" href={site.socials.find((s) => s.name === 'Twitch')?.url} rel="noopener">
          <span class="tiny">Twitch</span>
          <span class="card-title">Live events and matches</span>
          <span class="muted">Follow DoD streams and talk to the players live.</span>
        </a>
        <a class="card" href={site.socials.find((s) => s.name === 'YouTube')?.url} rel="noopener">
          <span class="tiny">YouTube</span>
          <span class="card-title">Build orders, reviews, cinematics</span>
          <span class="muted">Game reviews, AoM cinematography and music — beyond the game.</span>
        </a>
        <a class="card" href={site.discord} rel="noopener">
          <span class="tiny">Discord</span>
          <span class="card-title">The community hub</span>
          <span class="muted">Strategy, content and games with {site.discordMembers} members.</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap grid" style="--min:340px">
      <div class="card panel">
        <span class="eyebrow">Merch</span>
        <h2 class="h2">Suit up</h2>
        <p class="muted">Official Deities of Death gear — premium apparel for those who command the battlefield. Orders and shipping run through our partner Fourthwall.</p>
        <div class="btns"><a class="btn light" href={shop} rel="noopener">Enter the shop</a></div>
      </div>
      <div class="card panel">
        <span class="eyebrow">Donate</span>
        <h2 class="h2">Support DoD</h2>
        <p class="muted">Enjoy the league, the tools and the streams? Support DoD with a tip. Sponsors and partners: get in touch.</p>
        <div class="btns">
          <a class="btn" href={site.donate} rel="noopener">Donate</a>
          <a class="btn" href={`mailto:${site.businessEmail}`}>Business enquiries</a>
        </div>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap section cta">
      <h2 class="display-l">{site.motto}</h2>
      <p class="lead">From online battles to real-life friendships — more than a clan.</p>
      <div class="btns"><a class="btn primary" href={site.discord} rel="noopener">Join our Discord</a></div>
    </div>
  </section>
</Base>

<style>
  .home-hero { position: relative; overflow: hidden; }
  .hero-grid { position: relative; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 24px; align-items: center; padding-block: clamp(56px, 9vw, 112px) 56px; }
  .hero-copy { grid-column: 1 / span 7; min-width: 0; }
  .hero-art { grid-column: 8 / span 5; display: grid; place-items: center; }
  .hero-art img { width: 100%; max-width: 460px; height: auto; }
  .hero-title { font-family: 'Cinzel Decorative', 'Cinzel', Georgia, serif; font-weight: 700; font-size: clamp(48px, 7.4vw, 104px); line-height: 0.95; letter-spacing: -0.01em; text-wrap: balance; }
  .hero-sub { display: block; margin-top: 18px; font-family: var(--font-display); font-weight: 600; font-size: clamp(20px, 2.2vw, 28px); line-height: 1; letter-spacing: 0.5em; color: var(--red-text); text-shadow: 0 0 28px rgba(192, 57, 43, 0.45); }
  .home-hero .btn.primary { box-shadow: 0 8px 32px -8px rgba(192, 57, 43, 0.7); }
  .home-hero .btn.primary:hover { box-shadow: 0 10px 44px -6px rgba(224, 74, 59, 0.85); }
  /* Sparks: confined by script to the copy column, so the logo side stays pure black */
  .embers { position: absolute; left: 0; top: 0; width: 0; height: 0; pointer-events: none; -webkit-mask-image: linear-gradient(90deg, #000 85%, transparent); mask-image: linear-gradient(90deg, #000 85%, transparent); }
  @media (max-width: 860px) {
    .hero-copy, .hero-art { grid-column: 1 / -1; }
    .hero-art { order: -1; }
    .hero-art img { max-width: 300px; }
    .embers { -webkit-mask-image: linear-gradient(180deg, transparent, #000 15%); mask-image: linear-gradient(180deg, transparent, #000 15%); }
  }

  .event-strip { display: block; text-decoration: none; border-block: 1px solid var(--line); background: linear-gradient(90deg, rgba(192, 57, 43, 0.22), rgba(192, 57, 43, 0.05) 45%, transparent 80%); position: relative; }
  .event-strip::before { content: ''; position: absolute; inset: -1px 0 auto; height: 2px; background: linear-gradient(90deg, transparent, var(--red) 30%, var(--red-text) 50%, var(--red) 70%, transparent); }
  .event-strip:hover { color: var(--text); background: linear-gradient(90deg, rgba(192, 57, 43, 0.3), rgba(192, 57, 43, 0.08) 45%, transparent 80%); }
  .event-strip-inner { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 28px; min-height: 72px; padding-block: 16px; }
  .es-label { display: inline-flex; align-items: center; gap: 10px; font-family: var(--font-display); font-weight: 600; font-size: 15px; letter-spacing: 0.06em; color: var(--red-text); }
  .es-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--red-text); }
  .es-title { font-family: var(--font-display); font-weight: 700; font-size: 24px; line-height: 1.1; }
  .es-meta { color: var(--muted); font-size: 15px; }
  .es-go { margin-left: auto; display: inline-flex; align-items: center; gap: 8px; font-weight: 600; }
  .event-strip:hover .es-go svg { transform: translateX(4px); }
  .es-go svg { transition: transform 0.25s var(--ease-out); }
  @media (max-width: 720px) { .es-go { margin-left: 0; } }
  .game { min-height: 380px; justify-content: space-between; gap: 32px; }
  .game-top { display: flex; justify-content: space-between; align-items: start; gap: 16px; }
  .game-links { display: flex; flex-wrap: wrap; gap: 8px 24px; border-top: 1px solid var(--line); padding-top: 16px; }
  .game-links a { font-weight: 600; text-decoration: none; min-height: 32px; display: inline-flex; align-items: center; }
  .split { display: grid; gap: 48px; align-items: center; grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr)); }
  .coach-top { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
  .elo { font-family: var(--font-display); font-weight: 700; font-size: 24px; }
  .price { font-weight: 600; border-top: 1px solid var(--line); padding-top: 12px; margin-top: auto; }
  .panel { gap: 16px; }
  .cta { display: flex; flex-direction: column; gap: 20px; align-items: flex-start; }
</style>

<script>
  // Red embers drifting up the copy side of the hero, echoing the intro clip.
  // Sized to stop short of the logo column, and re-sized whenever the hero changes size.
  function embers() {
    const c = document.getElementById('heroEmbers') as HTMLCanvasElement | null;
    if (!c || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const hero = c.closest('.home-hero') as HTMLElement, art = hero.querySelector('.hero-art') as HTMLElement;
    const ctx = c.getContext('2d')!;
    const stacked = matchMedia('(max-width: 860px)');
    type P = { x: number; y: number; r: number; vy: number; vx: number; life: number; max: number; hue: string };
    const parts: P[] = [];
    let W = 0, H = 0;
    const spawn = (y?: number): P => ({ x: Math.random() * W, y: y ?? H + 10, r: 0.8 + Math.random() * 2, vy: 0.3 + Math.random() * 0.8, vx: (Math.random() - 0.5) * 0.3, life: 0, max: 240 + Math.random() * 320, hue: Math.random() < 0.7 ? '224,74,59' : '255,140,80' });
    const size = () => {
      const dpr = Math.min(devicePixelRatio || 1, 2);
      const hr = hero.getBoundingClientRect(), ar = art.getBoundingClientRect();
      if (!hr.width || !hr.height) { W = H = 0; return; }
      let y = 0;
      if (stacked.matches) { y = Math.max(0, ar.bottom - hr.top); W = hr.width; H = hr.height - y; }
      else { W = Math.max(0, ar.left - hr.left - 24); H = hr.height; }
      Object.assign(c.style, { top: `${y}px`, width: `${W}px`, height: `${H}px` });
      if (!W || !H) return;
      c.width = W * dpr; c.height = H * dpr; ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const want = Math.round(Math.min(60, Math.max(20, W / 14)));
      while (parts.length < want) parts.push(spawn(Math.random() * H));
      parts.length = want;
      for (const p of parts) if (p.x > W || p.y > H + 10) Object.assign(p, spawn(Math.random() * H));
    };
    size();
    const ro = new ResizeObserver(size); ro.observe(hero);
    const tick = () => {
      if (!c.isConnected) { ro.disconnect(); return; }   // left the homepage
      if (W && H) {
        ctx.clearRect(0, 0, W, H);
        for (const p of parts) {
          p.life++; p.y -= p.vy; p.x += p.vx + Math.sin(p.life / 40) * 0.15;
          const a = Math.sin(Math.PI * Math.min(p.life / p.max, 1)) * 0.9;
          ctx.beginPath(); ctx.fillStyle = `rgba(${p.hue},${a})`; ctx.shadowColor = `rgba(${p.hue},${a})`; ctx.shadowBlur = 10;
          ctx.arc(p.x, p.y, p.r, 0, 6.283); ctx.fill();
          if (p.life > p.max || p.y < -10 || p.x < -10 || p.x > W + 10) Object.assign(p, spawn());
        }
      }
      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  }
  document.addEventListener('astro:page-load', embers);
</script>
