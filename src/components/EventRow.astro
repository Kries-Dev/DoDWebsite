---
import type { DodEvent } from '../lib/events';
interface Props { event: DodEvent; past?: boolean }
const { event, past = false } = Astro.props;
---
<a class:list={['row', 'ev-row', { 'has-logo': !!event.logo }]} href={`/events/${event.slug}/`}>
  {event.logo && <img class="ev-logo" src={event.logo} alt="" width="64" height="57" loading="lazy" />}
  <span class="row-date">{event.when}</span>
  <span class="row-title">{event.title}</span>
  <span class="muted small" style="min-width:200px">{event.game}</span>
  <span class:list={['chip', { 'chip-on': !past }]}>{past ? <span class="ring" /> : <span class="dot" />}{past ? 'Finished' : event.tba ? 'Upcoming' : event.kind}</span>
</a>
<style>
  .ev-logo { width: 64px; height: auto; flex: none; }
  .chip-on { border-color: var(--red); }
</style>
