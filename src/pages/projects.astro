---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
import projects from '../data/projects.json';
import '@fontsource/cinzel-decorative/700.css';
const aom = projects.filter((p) => (p.game ?? 'aom') === 'aom');
---
<Base title="Tools and mods" description="Deities of Death community projects for Age of Mythology: Retold — trainers, tournament tools and mods — and Game of Thrones: War for Westeros coming soon.">
  <section class="page-hero">
    <div class="wrap stack">
      <span class="eyebrow">Projects</span>
      <h1 class="display-l">Tools and mods</h1>
      <p class="lead">Deities of Death community projects and modifications — free for everyone.</p>
    </div>
  </section>
  <section class="section pr">
    <div class="wrap" data-tabs>
      <div class="tabs pr-tabs" role="tablist" aria-label="Game">
        <button class="tab" role="tab" id="tab-aom" aria-controls="panel-aom" aria-selected="true" data-hash="aom">
          Age of Mythology: Retold <span class="tab-tag on">{aom.length} projects</span>
        </button>
        <button class="tab" role="tab" id="tab-got" aria-controls="panel-got" aria-selected="false" tabindex="-1" data-hash="got">
          Game of Thrones: War for Westeros <span class="tab-tag">Coming soon</span>
        </button>
      </div>
    </div>

    <div id="panel-aom" role="tabpanel" aria-labelledby="tab-aom" tabindex="0">
      <div class="wrap grid" style="--min:320px">
        {aom.map((p) => (
          <article class="card" style="justify-content:space-between;min-height:260px">
            <div class="stack" style="--gap:12px">
              <span class="chip">{p.kind}</span>
              <h2 class="card-title">{p.name}</h2>
              <p class="tiny">By {p.authors}</p>
              <p class="muted">{p.description}</p>
            </div>
            <div class="btns" style="padding-top:8px">
              {p.url
                ? <a class="btn sm light" href={p.url} rel="noopener">{p.action}</a>
                : <a class="btn sm" href={site.discord} rel="noopener">Get it on Discord</a>}
            </div>
          </article>
        ))}
      </div>
    </div>

    <div id="panel-got" role="tabpanel" aria-labelledby="tab-got" tabindex="0" hidden>
      <div class="wrap">
        <div class="soon">
          <img class="soon-art" src="/games/wfw-keyart-616.webp" alt="Game of Thrones: War for Westeros" width="616" height="353" loading="lazy" />
          <div class="soon-body">
            <p class="soon-title">Coming soon...</p>
            <p class="lead">Tools and mods for War for Westeros follow once the game is out.</p>
            <div class="btns">
              <a class="btn primary" href="/games/war-for-westeros/">War for Westeros hub</a>
              <a class="btn" href={site.discord} rel="noopener">Join our Discord</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .pr { padding-top: clamp(24px, 4vw, 40px); }
  .pr-tabs { margin-bottom: clamp(24px, 4vw, 40px); }
  .soon { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); align-items: center; border: 1px solid var(--line); background: var(--surface); }
  .soon-art { display: block; width: 100%; height: 100%; object-fit: cover; aspect-ratio: 616 / 353; }
  .soon-body { display: flex; flex-direction: column; gap: 16px; padding: clamp(24px, 4vw, 48px); }
  .soon-title { font-family: 'Cinzel Decorative', 'Cinzel', Georgia, serif; font-weight: 700; font-size: clamp(34px, 4.6vw, 64px); line-height: 1; }
  @media (max-width: 860px) { .soon { grid-template-columns: 1fr; } }
</style>
