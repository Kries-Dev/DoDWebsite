---
import site from '../data/site.json';
import Mark from './Mark.astro';

const nav = [
  { label: 'About', href: '/about/' },
  { label: 'Games', href: '/games/' },
  { label: 'Build Orders', href: '/build-orders/' },
  { label: 'MCL', href: '/competitions/mcl/' },
  { label: 'Events', href: '/events/' },
  { label: 'Coaching', href: '/coaching/' },
  { label: 'Projects', href: '/projects/' },
  { label: 'Merch', href: site.shopUrl, external: true },
];
// Compare without the base path (e.g. /DoDWebsite) so the active menu item works on GitHub Pages too.
const path = Astro.url.pathname.slice(import.meta.env.BASE_URL.replace(/\/$/, '').length) || '/';
// God pages live under /games/aom/build-orders/ but belong to the Build Orders section.
const isCurrent = (href: string) =>
  href === '/build-orders/' ? path.startsWith('/build-orders/') || path.startsWith('/games/aom/build-orders/')
  : href === '/games/' ? path.startsWith('/games/') && !path.startsWith('/games/aom/build-orders/')
  : path === href || path.startsWith(href);
---
<header class="site-header">
  <div class="wrap bar">
    <a href="/" class="brand">
      <Mark />
      <span class="brand-name">{site.name}</span>
    </a>
    <nav aria-label="Main" class="nav">
      {nav.map((item) => (
        item.external
          ? <a href={item.href} rel="noopener" target="_blank">{item.label}<svg class="ext" width="11" height="11" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 2h6v6M10 2 3 9" /></svg><span class="sr-only"> (opens the shop in a new tab)</span></a>
          : <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>
    <a class="btn primary sm discord" href={site.discord} rel="noopener">Join our Discord</a>
  </div>
</header>
<style>
  .site-header { border-bottom: 1px solid var(--line); background: var(--bg); position: sticky; top: 0; z-index: 5; }
  .bar { display: flex; align-items: center; gap: 24px; min-height: 76px; flex-wrap: wrap; padding-block: 12px; }
  .brand { display: flex; align-items: center; gap: 12px; text-decoration: none; margin-right: auto; }
  .brand-name { font-family: var(--font-display); font-weight: 600; font-size: 24px; }
  .nav { display: flex; gap: 28px; align-items: center; }
  .nav a { text-decoration: none; font-weight: 500; font-size: 15px; padding-block: 8px; border-bottom: 2px solid transparent; }
  .nav a[aria-current='page'] { font-weight: 600; border-bottom-color: var(--red); }
  .nav a { display: inline-flex; align-items: center; gap: 4px; position: relative; }
  .ext { opacity: 0.6; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  @media (max-width: 1180px) {
    .bar { gap: 12px 16px; }
    .nav { order: 3; width: 100%; overflow-x: auto; gap: 24px; padding-bottom: 2px; scrollbar-width: none; }
    .nav::-webkit-scrollbar { display: none; }
    .nav a { white-space: nowrap; min-height: 44px; display: inline-flex; align-items: center; }
  }
  @media (max-width: 480px) {
    .brand-name { font-size: 20px; }
    .discord { padding: 0 14px; }
  }
</style>
