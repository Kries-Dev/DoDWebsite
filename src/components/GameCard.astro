---
// One game tile with the game's key art as background. Every GameCard has the same fixed shape
// (16:10, min 360px tall) so cards in a row always line up, whatever their text.
// The key art carries the game's own logo at the top, so our text sits at the bottom over a dark fade.
interface Link { label: string; href: string }
interface Props {
  game: 'aom' | 'wfw';
  status: string;
  active?: boolean;
  title: string;
  text: string;
  href?: string;
  links?: Link[];
}
const { game, status, active = false, title, text, href, links = [] } = Astro.props;
const art = game === 'aom'
  ? { src: '/games/aom-keyart-1600.webp', srcset: '/games/aom-keyart-900.webp 900w, /games/aom-keyart-1600.webp 1600w', pos: '50% 30%' }
  : { src: '/games/wfw-keyart-616.webp', srcset: undefined, pos: '50% 50%' };
const Tag = href ? 'a' : 'article';
---
<Tag class:list={['game-card', { linked: !!href }]} href={href} data-game={game}>
  <span class="gc-media">
    <img class="gc-art" src={art.src} srcset={art.srcset} sizes="(max-width: 760px) 100vw, 50vw" alt="" loading="lazy" decoding="async" />
    <span class="gc-shade" aria-hidden="true"></span>
  </span>
  <span class="gc-body">
    <span class:list={['gc-status', { on: active }]}><span class="gc-dot" />{status}</span>
    <span class="gc-title">{title}</span>
    <span class="gc-text">{text}</span>
    {links.length > 0 && (
      <span class="gc-links">{links.map((l) => <a href={l.href}>{l.label}</a>)}</span>
    )}
  </span>
</Tag>

<style>
  /* Key art on top, shown whole (both images are ~16:9, so nothing of the logo is cut), text below.
     Cards in a row stretch to the same height, and the links sit on the same line at the bottom. */
  .game-card { position: relative; display: flex; flex-direction: column; height: 100%; overflow: hidden;
    border: 1px solid var(--line); background: var(--surface); text-decoration: none; color: var(--text); }
  .gc-media { position: relative; display: block; aspect-ratio: 16 / 9; overflow: hidden; background: var(--bg-deep); }
  .gc-art { display: block; width: 100%; height: 100%; object-fit: cover; transition: filter 0.4s; }
  .gc-shade { position: absolute; inset: 0; pointer-events: none; background: linear-gradient(180deg, transparent 70%, var(--surface) 100%); }
  .gc-body { flex: 1; display: flex; flex-direction: column; gap: 12px; padding: 0 clamp(20px, 3vw, 32px) clamp(20px, 3vw, 28px); margin-top: -18px; position: relative; }
  .gc-status { align-self: flex-start; display: inline-flex; align-items: center; gap: 8px; padding: 6px 12px; font-size: 13px; font-weight: 600; letter-spacing: 0.04em;
    background: rgba(8,8,8,0.85); border: 1px solid rgba(245,245,245,0.25); }
  .gc-dot { width: 8px; height: 8px; border: 1.5px solid var(--muted); }
  .gc-status.on { border-color: var(--red); }
  .gc-status.on .gc-dot { border: 0; background: var(--red-text); border-radius: 50%; box-shadow: 0 0 10px rgba(224,74,59,0.8); }
  /* The key art already shows the game's logo, so the text title is for screen readers only */
  .gc-title { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .gc-text { color: var(--muted); max-width: 52ch; }
  .gc-links { margin-top: auto; display: flex; flex-wrap: wrap; gap: 6px 22px; padding-top: 14px; border-top: 1px solid var(--line); }
  .gc-links a { font-weight: 600; text-decoration: none; min-height: 32px; display: inline-flex; align-items: center; }
  .gc-links a:hover { color: var(--red-text); }
  .game-card.linked { transition: border-color 0.3s; }
  .game-card.linked:hover { border-color: var(--red); color: var(--text); }
  .game-card:hover .gc-art { filter: brightness(1.1) saturate(1.08); }
</style>
